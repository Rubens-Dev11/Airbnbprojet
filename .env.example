# Modèle de configuration. Copier en `.env.local` et renseigner les valeurs.
#
# ⚠ Ce fichier ne contient que des NOMS de clés. Aucune valeur réelle ne doit
# y figurer, ni y être commitée : un secret publié ne se dépublie pas, il se
# révoque. `.env` et `.env.local` sont ignorés par git — vérifié avec
# `git check-ignore`.

# --- Supabase ----------------------------------------------------------------
# Fournis par `supabase start` en local, ou par le tableau de bord du projet.
# Région retenue : Paris (eu-west-3) — latence mesurée depuis le Cameroun,
# voir docs/memory/decisions/ADR-004-supabase-et-docker.md
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Contourne RLS. Réservé aux traitements serveur (agent IA, tâches planifiées).
# NE JAMAIS l'exposer au navigateur ni la préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Agent IA ----------------------------------------------------------------
# Côté serveur uniquement (CDC §8.2). Le mobile appelle une route, jamais
# l'API du fournisseur directement.
OPENAI_API_KEY=

# --- Paiement ----------------------------------------------------------------
# MVP : encaissement MANUEL (ADR-008). Aucun agrégateur, aucun webhook.
# Numéro Mobile Money sur lequel les avances sont reçues, affiché au locataire.
MOMO_DEPOSIT_NUMBER=
MOMO_DEPOSIT_HOLDER_NAME=

# --- Choix du fournisseur de modèle -------------------------------------------
# La latence ne tranche pas : mesuré depuis le Cameroun le 7 août 2026,
# OpenAI 41 ms et Anthropic 68 ms, à comparer aux ~250 ms de chaque requête
# vers la base. Ce qui décidera est la qualité de compréhension du français
# camerounais — c'est ce que la Phase 1 doit mesurer, sur le MÊME jeu de
# requêtes pour les deux.
AGENT_PROVIDER=nvidia
# Laisser vide pour le modèle par défaut du fournisseur.
AGENT_MODEL=
ANTHROPIC_API_KEY=

# --- NVIDIA NIM (compatible OpenAI) -------------------------------------------
# Vérifié : GET https://integrate.api.nvidia.com/v1/models répond 200 au format
# OpenAI. Un seul baseURL suffit, pas de client dédié.
#
# ⚠ La clé du palier gratuit est marquée « for API testing use only » par NVIDIA
# elle-même. Convient à la Phase 1 (mesure), PAS à la production.
NVIDIA_API_KEY=
